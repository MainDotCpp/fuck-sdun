{
  "name": "fuck-sdun",
  "version": "1.0.0",
  "description": "Playwright mobile device fingerprint simulation for anti-detection",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "tsx tests/fingerprint.test.ts",
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs fuck-sdun",
    "pm2:status": "pm2 status",
    "start:prod": "bash scripts/start.sh",
    "setup": "pnpm install && pnpm prisma generate && pnpm next:build"
