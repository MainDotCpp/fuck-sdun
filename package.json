    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "next": "^16.0.3",
    "playwright": "^1.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^1.4.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
